# ==============================================================================
# HYCO Property Management - Admin System Environment Variables
# ==============================================================================

# Database Connection (PostgreSQL - e.g. Easypanel internal connection)
DATABASE_URL=postgres://postgres:password@hycoproperty_db_hyco:5432/hycoproperty?sslmode=disable

# Session Security Secret (Generate a strong 32+ character random string)
SESSION_SECRET=your_secure_session_secret_here

# Initial Super Admin / Admin Accounts (Hashed automatically on startup)
ADMIN_EMAIL=admin@hycoproperty.com
ADMIN_PASSWORD=your_secure_password_here

SUPERADMIN_EMAIL=rhectoroc@gmail.com
SUPERADMIN_PASSWORD=your_secure_password_here
